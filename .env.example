# Environment Variables Configuration Template
# 复制此文件为 .env 并填写实际值

# ==================== 数据库配置 ====================
# MySQL 主数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_NAME=quantum_db
DB_CONNECTION_LIMIT=500
DB_QUEUE_LIMIT=0

# 游戏数据库配置 (如果使用独立游戏数据库)
GAME_DB_HOST=127.0.0.1
GAME_DB_PORT=3306
GAME_DB_USER=root
GAME_DB_PASSWORD=your_game_db_password_here
GAME_DB_NAME=game_db
GAME_DB_CONNECTION_LIMIT=50
GAME_DB_QUEUE_LIMIT=0

# ==================== Redis 配置 ====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ==================== JWT 认证配置 ====================
# JWT 签名密钥 (必须是随机强密钥，至少 32 字符)
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_32_chars_random_string_here

# JWT 过期时间 (默认 4 小时)
JWT_EXPIRES_IN=4h

# Cookie 配置
JWT_COOKIE_NAME=quantum_auth_token
JWT_COOKIE_MAX_AGE=14400000

# ==================== 管理员 Session 配置 ====================
# 管理员 Session 签名密钥 (必须是随机强密钥)
ADMIN_SESSION_SECRET=your_admin_session_secret_min_32_chars_here

# ==================== API 签名配置 ====================
# API 签名密钥 (用于客户端-服务器通信签名验证)
API_SIGN_KEY=your_api_sign_key_here

# API 签名时间偏差容忍度 (秒)
API_SIGN_SKEW_SEC=60

# ==================== 第三方支付配置 ====================
# 支付网关配置 (根据实际使用的支付网关填写)
PAYMENT_NOTIFY_BASE_URL=https://your-domain.com
PAYMENT_CALLBACK_SECRET=your_payment_callback_secret_here

# ==================== 游戏服务器配置 ====================
# 游戏服务器 IP/域名
GAME_SERVER_HOST=your_game_server_host_here
GAME_SERVER_PORT=your_game_server_port_here

# ==================== 应用配置 ====================
# 运行环境 (development / production)
NODE_ENV=production

# 日志级别 (error / warn / info / debug)
LOG_LEVEL=info

# 服务名称 (用于日志标识)
SERVICE_NAME=quantum-publish

# 服务端口 (Nuxt 默认 3000)
PORT=3000

# ==================== CDN 配置 ====================
# 如果使用 CDN，配置 CDN 相关信息
CDN_DOMAIN=

# ==================== 安全配置 ====================
# CORS 允许的域名 (多个域名用逗号分隔)
CORS_ORIGINS=https://your-frontend-domain.com

# 是否启用 HTTPS
HTTPS_ENABLED=true

# ==================== 第三方服务配置 ====================
# 第三方 API 配置 (如果有)
THIRD_PARTY_API_URL=
THIRD_PARTY_API_KEY=

# ==================== 监控和告警配置 ====================
# Sentry DSN (如果使用 Sentry 错误监控)
SENTRY_DSN=

# ==================== 注意事项 ====================
# 1. 绝对不要将 .env 文件提交到 Git 仓库
# 2. 所有密钥必须是随机生成的强密钥
# 3. 生产环境的密钥必须与开发/测试环境不同
# 4. 定期轮换密钥 (建议每季度一次)
# 5. 确保 .env 文件的权限设置为 600 (只有所有者可读写)

# ==================== 密钥生成示例 ====================
# 生成 JWT_SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 生成 ADMIN_SESSION_SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 生成 API_SIGN_KEY:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
